datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id       String    @id @default(uuid())
  email    String    @unique
  name     String?
  bookings Booking[]
}

model Booking {
  id        String   @id @default(uuid())
  userId    String
  seatId    String
  showId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  // Composite unique constraint: Prevents booking the same seat for the same show twice
  @@unique([seatId, showId])
}